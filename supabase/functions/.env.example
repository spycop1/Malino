# Ausschließlich als Supabase Edge Secrets hinterlegen, NICHT ins GitHub-Repository!
OPENAI_API_KEY=DEIN_OPENAI_API_SCHLUESSEL
MALINO_ALLOWED_EMAILS=deine-elternadresse@beispiel.de
# Optional: Fallback, falls Supabase keine automatischen Admin-Schlüssel bereitstellt
# MALINO_SUPABASE_SECRET_KEY=sb_secret_...
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
